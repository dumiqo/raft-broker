<Project>

  <!-- Общие свойства для всех проектов решения (S0-T01). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Диагностика: анализаторы включены на уровне SDK по умолчанию для net5.0+. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Воспроизводимость восстановления пакетов (S0-T02).
       packages.lock.json коммитится в репозиторий; CI обязан восстанавливаться
       в locked-режиме, то есть падать, если lock-файл разошёлся с csproj. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!-- "CI" выставляет GitHub Actions. Локально lock-файлы обновляются обычным restore,
       и это единственное место, где они меняются осознанно. Гейт `scripts/verify.ps1`
       должен проверять то же самое локально (S0-T08). -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

</Project>
