<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RaftBroker.Server - хост узла. На S0 это приложение: оно поднимает порт, читает
    конфигурацию узла и пишет лог, чтобы `docker compose up` поднимал три различимых
    процесса (S0-T07). gRPC-сервис из proto/raft.proto подключается здесь же на S4-T01
    через UseKestrel/MapGrpcService, поэтому базовый образ рантайма выбран aspnet.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RaftBroker.Core/RaftBroker.Core.csproj" />
    <ProjectReference Include="../RaftBroker.Storage/RaftBroker.Storage.csproj" />
    <ProjectReference Include="../RaftBroker.Raft/RaftBroker.Raft.csproj" />
    <ProjectReference Include="../RaftBroker.StateMachine/RaftBroker.StateMachine.csproj" />
    <ProjectReference Include="../RaftBroker.Transport/RaftBroker.Transport.csproj" />
  </ItemGroup>

</Project>
