<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    S0-T02: источники пакетов фиксируются в репозитории.
    Без этого файла результат restore зависит от машины: на этой машине в глобальном
    NuGet.Config есть второй источник "My local package source" (C:\NuGetPackages\),
    и пакет с тем же id/версией мог бы приехать из него.
    <clear /> убирает всё, что унаследовано от глобального и пользовательского конфигов;
    остаётся один источник - nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
