# Контекст сборки образа узла - корень решения, поэтому сюда попадает всё лишнее.
#
# Каталог deploy/ НЕ исключается: Dockerfile лежит внутри него, и выкидывать каталог
# с файлом сборки из контекста - способ получить непонятную ошибку на другом билдере.

# История и настройки рабочих сред.
.git
.gitignore
.gitattributes
.vs
.vscode
.idea

# Артефакты сборки: их копирование в образ - источник "у меня собирается, а в CI нет".
**/bin/
**/obj/
**/TestResults/
*.user
*.suo

# В образ нужны только src/, proto/ и файлы сборки.
tests/
docs/
scripts/
README.md
