<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тестовый проект xunit.v3 - это исполняемая сборка (S0-T03). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RaftBroker.Core/RaftBroker.Core.csproj" />
    <ProjectReference Include="../../src/RaftBroker.Server/RaftBroker.Server.csproj" />
    <ProjectReference Include="../../src/RaftBroker.Client/RaftBroker.Client.csproj" />
    <ProjectReference Include="../RaftBroker.TestKit/RaftBroker.TestKit.csproj" />

    <!-- Жертва краш-тестов (S1-T05): сборка нужна не для кода, а чтобы родительский тест
         нашёл её в своём каталоге вывода и сборка шла в правильном порядке. -->
    <ProjectReference Include="../RaftBroker.CrashHarness/RaftBroker.CrashHarness.csproj" />
  </ItemGroup>

</Project>
